{
  "name": "orfina-backend",
  "version": "0.7.3",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest --runInBand --testPathIgnorePatterns=integration",
    "test:integration": "node --env-file-if-exists=.env ./node_modules/jest/bin/jest.js --runInBand --testRegex=.*\\.integration\\.spec\\.ts$",
    "seed:test-data": "ts-node src/scripts/seed-finance-test-data.ts",
    "smoke:health": "node scripts/smoke-health.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "admin:bootstrap": "node --env-file-if-exists=.env -r ts-node/register src/scripts/admin.ts bootstrap",
    "admin:operate": "node --env-file-if-exists=.env -r ts-node/register src/scripts/admin.ts",
    "admin:identify": "node --env-file-if-exists=.env -r ts-node/register src/scripts/admin-identify.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.0.1",
    "@prisma/client": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jose": "^5.9.6",
    "nats": "^2.29.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prisma": "^6.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "fastify": "^5.12.5",
    "deepmerge-ts": "^8.0.0"
  }
}
