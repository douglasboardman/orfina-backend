generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HouseholdRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AccountType {
  CHECKING
  SALARY
  SAVINGS
  INVESTMENT
  CASH
}

enum CardNetwork {
  VISA
  MASTERCARD
  ELO
  AMERICAN_EXPRESS
  HIPERCARD
  DINERS_CLUB
  DISCOVER
  JCB
  UNIONPAY
  MAESTRO
  OTHER
}

enum CardStatementStatus {
  OPEN
  CLOSED
  PAID
}

enum RecurringRuleStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum SavingsGoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  POSTED
  DISCARDED
}

enum AccountTransferStatus {
  PENDING
  POSTED
  DISCARDED
}

enum ImportBatchStatus {
  DRAFT
  VALIDATED
  COMMITTED
  CANCELED
  FAILED
}

enum ImportItemStatus {
  VALID
  INVALID
  POSSIBLE_DUPLICATE
  COMMITTED
  CANCELED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum HouseholdInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String
  avatarUrl    String?
  googleId     String?           @unique
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  memberships  HouseholdMember[]
  sessions     Session[]
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model Household {
  id          String            @id @default(cuid())
  name        String
  currency    String            @default("BRL")
  timezone    String            @default("America/Sao_Paulo")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     HouseholdMember[]
  invitations HouseholdInvitation[]
  accounts    Account[]
  categories  Category[]
  transactions Transaction[]
  transfers    AccountTransfer[]
  importBatches ImportBatch[]
  importItems   ImportItem[]
  cards            Card[]
  cardStatements   CardStatement[]
  cardPayments     CardPayment[]
  installmentPurchases InstallmentPurchase[]
  recurringRules   RecurringRule[]
  auditLogs        AuditLog[]
  monthlyBudgets   MonthlyBudget[]
  budgetMonths     BudgetMonth[]
  savingsGoals     SavingsGoal[]
  goalContributions GoalContribution[]
}

model Card {
  id                 String      @id @default(cuid())
  householdId        String
  name               String
  issuerName         String?
  issuerLogoUrl      String?
  network            CardNetwork
  lastFour           String?
  creditLimit        Int?
  closingDay         Int         @default(1)
  dueDay             Int         @default(10)
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  household          Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  statements         CardStatement[]
  installmentPurchases InstallmentPurchase[]
  recurringRules     RecurringRule[]
  @@index([householdId, isActive])
}

model HouseholdMember {
  householdId String
  userId      String
  role        HouseholdRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([householdId, userId])
  @@index([userId])
}

model HouseholdInvitation {
  id          String                    @id @default(cuid())
  householdId String
  email       String
  role        HouseholdRole             @default(MEMBER)
  status      HouseholdInvitationStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  household   Household                 @relation(fields: [householdId], references: [id], onDelete: Cascade)
  @@index([householdId, status])
  @@index([email, status])
}

model Account {
  id             String      @id @default(cuid())
  householdId    String
  name           String
  type           AccountType
  bankName       String?
  bankLogoUrl    String?
  initialBalance Int         @default(0)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  household      Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  outgoingTransfers AccountTransfer[] @relation("TransferSource")
  incomingTransfers AccountTransfer[] @relation("TransferDestination")
  cardPayments   CardPayment[]
  recurringRules RecurringRule[]
  @@index([householdId])
}

model Category {
  id          String       @id @default(cuid())
  householdId String
  name        String
  type        CategoryType
  color       String       @default("#5B5BD6")
  icon        String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  household    Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  subcategories Subcategory[]
  installmentPurchases InstallmentPurchase[]
  recurringRules RecurringRule[]
  monthlyBudgets MonthlyBudget[]
  @@unique([householdId, name, type])
  @@index([householdId, type])
}

model Subcategory {
  id           String        @id @default(cuid())
  categoryId   String
  name         String
  isDefault    Boolean       @default(false)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  installmentPurchases InstallmentPurchase[]
  recurringRules RecurringRule[]
  @@unique([categoryId, name])
  @@index([categoryId])
}

model Transaction {
  id          String          @id @default(cuid())
  householdId String
  accountId   String?
  cardId      String?
  statementId String?
  installmentPurchaseId String?
  installmentNumber Int?
  recurringRuleId String?
  recurrenceOn DateTime? @db.Date
  subcategoryId String
  type        TransactionType
  amount      Int
  description String
  occurredOn  DateTime        @db.Date
  notes       String?
  status      TransactionStatus @default(POSTED)
  importItemId String? @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  household   Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account     Account?        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  card        Card?           @relation(fields: [cardId], references: [id], onDelete: Restrict)
  statement   CardStatement?  @relation(fields: [statementId], references: [id], onDelete: Restrict)
  installmentPurchase InstallmentPurchase? @relation(fields: [installmentPurchaseId], references: [id], onDelete: Restrict)
  recurringRule RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: Restrict)
  subcategory Subcategory     @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  importItem  ImportItem?     @relation(fields: [importItemId], references: [id], onDelete: SetNull)
  @@index([householdId, occurredOn])
  @@index([householdId, status, occurredOn])
  @@index([accountId, occurredOn])
  @@index([cardId, occurredOn])
  @@index([statementId])
  @@index([installmentPurchaseId])
  @@unique([recurringRuleId, recurrenceOn])
  @@index([subcategoryId])
}

model AccountTransfer {
  id                String                @id @default(cuid())
  householdId       String
  sourceAccountId   String
  destinationAccountId String
  amount            Int
  occurredOn        DateTime              @db.Date
  status            AccountTransferStatus @default(POSTED)
  description       String?
  importItemId      String?               @unique
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  household         Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  sourceAccount     Account               @relation("TransferSource", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount Account               @relation("TransferDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  importItem        ImportItem?           @relation(fields: [importItemId], references: [id], onDelete: SetNull)
  @@index([householdId, occurredOn])
  @@index([sourceAccountId, occurredOn])
  @@index([destinationAccountId, occurredOn])
}

model ImportBatch {
  id              String            @id @default(cuid())
  householdId     String
  createdById     String
  sourceHash      String
  fileName        String?
  format          String
  mapping         Json?
  status          ImportBatchStatus @default(DRAFT)
  diagnostics     Json?
  committedAt     DateTime?
  canceledAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  household       Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items           ImportItem[]
  @@unique([householdId, sourceHash])
  @@index([householdId, status, createdAt])
}

model ImportItem {
  id              String           @id @default(cuid())
  householdId     String
  batchId         String
  rowNumber       Int
  fingerprint     String
  status          ImportItemStatus @default(VALID)
  data            Json
  diagnostics     Json?
  decidedById     String?
  decidedAt       DateTime?
  transaction     Transaction?
  transfer        AccountTransfer?
  batch           ImportBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  household       Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  @@unique([batchId, rowNumber])
  @@index([householdId, fingerprint])
  @@index([batchId, status])
}

model CardStatement {
  id          String              @id @default(cuid())
  householdId String
  cardId      String
  cycleStart  DateTime            @db.Date
  cycleEnd    DateTime            @db.Date
  dueOn       DateTime            @db.Date
  totalAmount Int                 @default(0)
  status      CardStatementStatus @default(OPEN)
  closedAt    DateTime?
  paidAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  household   Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  card        Card                @relation(fields: [cardId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  payments    CardPayment[]
  @@unique([cardId, cycleEnd])
  @@index([householdId, status, dueOn])
}

model CardPayment {
  id             String        @id @default(cuid())
  householdId    String
  statementId    String
  accountId      String
  amount         Int
  idempotencyKey String
  paidOn         DateTime      @db.Date
  createdAt      DateTime      @default(now())
  household      Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  statement      CardStatement @relation(fields: [statementId], references: [id], onDelete: Restrict)
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@unique([householdId, idempotencyKey])
  @@index([statementId])
  @@index([accountId, paidOn])
}

model InstallmentPurchase {
  id              String      @id @default(cuid())
  householdId     String
  cardId          String
  categoryId      String
  subcategoryId   String
  type            TransactionType
  totalAmount     Int
  installmentCount Int
  description     String
  firstOccurredOn DateTime    @db.Date
  canceledAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  household       Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  card            Card        @relation(fields: [cardId], references: [id], onDelete: Restrict)
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory     Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  transactions    Transaction[]
  @@index([householdId, cardId])
}

model RecurringRule {
  id            String              @id @default(cuid())
  householdId   String
  accountId     String?
  cardId        String?
  categoryId    String
  subcategoryId String
  type          TransactionType
  amount        Int
  description   String
  notes         String?
  startOn       DateTime            @db.Date
  endOn         DateTime?           @db.Date
  status        RecurringRuleStatus @default(ACTIVE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  household     Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account       Account?            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  card          Card?               @relation(fields: [cardId], references: [id], onDelete: Restrict)
  category      Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory   Subcategory          @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  transactions  Transaction[]
  @@index([householdId, status])
}

model AuditLog {
  id            String   @id @default(cuid())
  householdId   String
  actorId       String?
  aggregateType String
  aggregateId   String
  action        String
  changedFields Json?
  createdAt     DateTime @default(now())
  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  @@index([householdId, aggregateType, aggregateId, createdAt])
}

model MonthlyBudget {
  id             String   @id @default(cuid())
  householdId    String
  referenceMonth DateTime @db.Date
  categoryId     String
  limitAmount    Int
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  household      Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category       Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  @@unique([householdId, referenceMonth, categoryId])
  @@index([householdId, referenceMonth])
}

model BudgetMonth {
  id             String   @id @default(cuid())
  householdId    String
  referenceMonth DateTime @db.Date
  closedAt       DateTime?
  closedById     String?
  snapshot       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  household      Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  @@unique([householdId, referenceMonth])
  @@index([householdId, closedAt])
}

model SavingsGoal {
  id          String            @id @default(cuid())
  householdId String
  name        String
  targetAmount Int
  targetDate  DateTime?         @db.Date
  color       String            @default("#5B5BD6")
  icon        String?
  status      SavingsGoalStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  household   Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]
  @@index([householdId, status])
}

model GoalContribution {
  id             String      @id @default(cuid())
  householdId    String
  goalId         String
  actorId        String
  amount         Int
  occurredOn     DateTime    @db.Date
  notes          String?
  idempotencyKey String
  createdAt      DateTime    @default(now())
  household      Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  goal           SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Restrict)
  @@unique([householdId, idempotencyKey])
  @@index([goalId, occurredOn])
}

model OutboxEvent {
  id            String      @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventType     String
  version       Int         @default(1)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int         @default(0)
  nextAttemptAt DateTime?
  claimToken    String?
  claimedAt     DateTime?
  lastError     String?
  createdAt     DateTime    @default(now())
  publishedAt   DateTime?
  @@index([status, nextAttemptAt, claimedAt, createdAt])
}
